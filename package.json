{
  "name": "hexis",
  "version": "0.1.0",
  "description": "Hexis — Honeycomb hex-grid AI-native IDE",
  "type": "module",
  "bin": {
    "hexis": "./cli.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
